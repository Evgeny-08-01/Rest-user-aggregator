# ============================================================
# КОНФИГУРАЦИЯ ДЛЯ ЛОКАЛЬНОГО ЗАПУСКА (БЕЗ DOCKER)
# ============================================================

# Подключение к PostgreSQL (локально)
DB_PATH=postgres://postgres:your_password_here@localhost:5432/subscriptions?sslmode=disable

# Порт сервера
SERVER_PORT=8087

# Данные для PostgreSQL (если запускаешь локально)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=subscriptions

# Логирование
LOG_LEVEL=info
LOG_PATH=./logs/app.log

# Безопасность
JWT_SECRET=your_jwt_secret_here

# CORS (для фронтенда на другом порту)
FRONTEND_URL=http://localhost:8087

# Кэширование в REDIS
REDIS_ADDR=redis:6379