<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="➕ Создание шаблона"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <EditText
        android:id="@+id/etTemplateName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Название сервиса"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etTemplatePrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Цена (рубли)"
        android:inputType="number"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnSaveTemplate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Сохранить"
        android:textSize="16sp"/>

    <Button
        android:id="@+id/btnCancelTemplate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Отмена"
        android:backgroundTint="#888"
        android:layout_marginTop="8dp"/>

</LinearLayout>
